{
  "name": "tampersafe-relayer",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "TamperSafe relayer: device ingest, chain writer, listener, SSE, sim-box. Protocol module built first per docs/IMPLEMENTATION_PLAN.md M3.",
  "scripts": {
    "test": "node --import tsx --test test/protocol.test.ts test/ingest.test.ts test/box-sim.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node --import tsx src/server.ts",
    "sim": "node --import tsx scripts/orchestrator.ts",
    "box": "node --import tsx scripts/box-sim.ts",
    "box:e2e": "node --import tsx scripts/box-sim-e2e.ts"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "ethers": "^6.17.0",
    "express": "^5.2.1"
  }
}
