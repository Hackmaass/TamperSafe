{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "dashboard": {
      "root": "dashboard",
      "framework": "vite",
      "bindings": [
        {
          "type": "service",
          "service": "relayer",
          "format": "url",
          "env": "RELAYER_URL"
        }
      ]
    },
    "landing-page": {
      "root": "landing-page",
      "entrypoint": "server.js"
    },
    "relayer": {
      "root": "relayer",
      "framework": "express"
    }
  },
  "redirects": [
    {
      "source": "/landing",
      "destination": "/landing/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "relayer"
      }
    },
    {
      "source": "/landing",
      "destination": {
        "service": "landing-page"
      }
    },
    {
      "source": "/landing/(.*)",
      "destination": {
        "service": "landing-page"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "dashboard"
      }
    }
  ]
}
